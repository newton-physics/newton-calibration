<robot name="two_link">
  <link name="base">
    <inertial><mass value="1"/><inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/></inertial>
    <visual><geometry><mesh filename="package://two_link/meshes/marker.obj"/></geometry></visual>
  </link>
  <link name="upper">
    <inertial><origin xyz="0.5 0 0"/><mass value="2"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.18" iyz="0" izz="0.18"/></inertial>
    <visual><origin xyz="0.5 0 0"/><geometry><box size="1 0.06 0.06"/></geometry></visual>
  </link>
  <link name="forearm">
    <inertial><origin xyz="0.3 0 0"/><mass value="1"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.04"/></inertial>
    <visual><origin xyz="0.3 0 0"/><geometry><box size="0.6 0.05 0.05"/></geometry></visual>
  </link>
  <joint name="shoulder" type="revolute">
    <parent link="base"/><child link="upper"/><axis xyz="0 1 0"/>
    <limit lower="-2" upper="2" effort="10" velocity="10"/><dynamics damping="0.02"/>
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper"/><child link="forearm"/><origin xyz="1 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2" upper="2" effort="10" velocity="10"/><dynamics damping="0.015"/>
  </joint>
</robot>
